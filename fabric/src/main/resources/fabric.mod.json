{
	"schemaVersion": 1,
	"id": "yefira",
	"version": "${version}",
	"name": "Yefira",
	"description": "Real-time bidirectional synchronization bridge between Minecraft and Blender (MoziToolKit) via WebSocket.",
	"authors": [
		"mozi1924"
	],
	"contact": {
		"homepage": "https://github.com/mozi1924/mc-sync-blender",
		"sources": "https://github.com/mozi1924/mc-sync-blender",
		"issues": "https://github.com/mozi1924/mc-sync-blender/issues"
	},
	"license": "GPL-3.0",
	"icon": "assets/yefira/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mozi1924.yefira.fabric.YefiraFabric"
		],
		"client": [
			"com.mozi1924.yefira.fabric.client.YefiraClientFabric"
		]
	},
	"mixins": [
		"yefira.mixins.json",
		{
			"config": "yefira.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.14.0",
		"minecraft": ">=1.16.5",
		"java": ">=8",
		"fabric-api": "*"
	}
}